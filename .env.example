# Block Merge — environment variables
# Copy to .env.local and populate. See docs/decisions/ ADRs for setup steps:
# 0001 (analytics), 0002 (Firebase), 0009 (RevenueCat / store products).

# Firebase (auth, leaderboard, replay sync, subscription state)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# PostHog (product analytics — funnels, retention, share rate)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat (subscriptions — see docs/decisions/0009-store-product-setup.md)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry (crash reporting — see docs/decisions/0015-crash-reporting.md)
EXPO_PUBLIC_SENTRY_DSN=
